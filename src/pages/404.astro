---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다">
  <div class="shell" style="padding:48px 0 24px">
    <div class="card empty">
      <div style="font-size:40px" aria-hidden="true">🧭</div>
      <h1 style="font-size:22px;margin:8px 0">페이지를 찾을 수 없습니다</h1>
      <p style="margin:0 0 16px">주소가 바뀌었거나, 더 이상 제공하지 않는 과목·강의일 수 있습니다.</p>
      <a class="btn" href="/">홈으로 가기</a>
    </div>
  </div>
</Base>
