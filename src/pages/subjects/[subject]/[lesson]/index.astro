---
import { render } from 'astro:content';
import LessonLayout from '../../../../layouts/LessonLayout.astro';
import { getCatalog } from '../../../../lib/catalog';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.flatMap((subject) =>
    subject.lessons.map((lesson) => ({ params: { subject: subject.id, lesson: lesson.slug }, props: { subject, lesson } })),
  );
}
const { subject, lesson } = Astro.props;
const { Content } = await render(lesson.mdx);
const d = lesson.mdx.data;
---
<LessonLayout subject={subject} lesson={lesson}>
  <p class="lesson-summary">{lesson.summary}</p>
  <div class="card goals">
    <h2>이번 강의를 마치면</h2>
    <ul>{d.goals.map((g) => <li>{g}</li>)}</ul>
    {d.prerequisites.length > 0 && <p class="small muted" style="margin:8px 0 0">선수 지식: {d.prerequisites.join(', ')}</p>}
  </div>
  <div class="prose"><Content /></div>
</LessonLayout>
