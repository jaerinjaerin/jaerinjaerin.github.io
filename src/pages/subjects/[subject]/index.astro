---
import Base from '../../../layouts/Base.astro';
import { getCatalog } from '../../../lib/catalog';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.map((s) => ({ params: { subject: s.id }, props: { s } }));
}
const { s } = Astro.props;
const orders = s.lessons.map((l) => l.order);
---
<Base title={s.data.title} description={s.data.description}>
  <div class="shell">
    <section class="course-head" aria-labelledby="course-h">
      <div class="sheet-body grid-paper">
        <nav class="crumbs" aria-label="위치"><a href="/">과목 목록</a><span class="sep">/</span><span>{s.data.field}</span></nav>
        <h1 id="course-h">{s.data.title}</h1>
        <p class="lesson-summary">{s.data.description}</p>
        <div class="course-progress">
          <div class="progress" role="progressbar" aria-label="과목 진도" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="bar"><i id="fill"></i></div>
          <span id="progress-text">0 / {s.lessons.length}</span>
        </div>
        <a class="btn" id="resume" href={s.lessons[0]?.url}>1강부터 시작하기</a>
      </div>
      <dl class="titleblock">
        <div><dt>분야</dt><dd style="font-size:16px">{s.data.area}</dd></div>
        <div><dt>단원</dt><dd>{s.data.units.length}</dd></div>
        <div><dt>강의</dt><dd>{s.lessons.length}</dd></div>
      </dl>
    </section>

    {s.data.units.map((u) => {
      const ls = s.lessons.filter((l) => l.unit === u.id);
      if (!ls.length) return null;
      return (
        <section class="unit" aria-label={u.title}>
          <h2>{u.title}</h2>
          <ol class="lesson-list">
            {ls.map((l) => (
              <li>
                <a class="lesson-row" href={l.url} data-order={l.order}>
                  <span class="lesson-num">{String(l.order).padStart(2, '0')}</span>
                  <span><span class="t">{l.title}</span><br /><span class="s">{l.summary}</span></span>
                  <span class="s num">{l.mdx.data.minutes ? `${l.mdx.data.minutes}분` : ''}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })}
  </div>
  <script type="application/json" id="subject-data" set:html={JSON.stringify({ id: s.id, key: s.progressKey, orders, urls: s.lessons.map((l) => [l.order, l.url, l.title]) })} />
  <script>
    import { getDone, getLast } from '../../../scripts/progress';
    const d = JSON.parse(document.getElementById('subject-data')!.textContent || '{}');
    const done = getDone(d.key);
    let n = 0;
    document.querySelectorAll<HTMLElement>('.lesson-row').forEach((row) => {
      const ok = Boolean(done[String(Number(row.dataset.order) - 1)]);
      row.dataset.done = String(ok);
      if (ok) n++;
    });
    const pct = d.orders.length ? Math.round((n / d.orders.length) * 100) : 0;
    (document.getElementById('fill') as HTMLElement).style.width = pct + '%';
    document.getElementById('bar')!.setAttribute('aria-valuenow', String(pct));
    document.getElementById('progress-text')!.textContent = `${n} / ${d.orders.length}강 완료`;
    const last = getLast();
    if (last.subject === d.id && last.order) {
      const hit = d.urls.find((u: [number, string, string]) => u[0] === last.order);
      if (hit) {
        const a = document.getElementById('resume') as HTMLAnchorElement;
        a.href = hit[1];
        a.textContent = `${hit[0]}강 이어서 학습하기`;
      }
    }
  </script>
</Base>
