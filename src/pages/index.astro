---
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/catalog';

const catalog = await getCatalog();
const fields = ['전체', ...new Set(catalog.map((s) => s.data.field))];
const totalLessons = catalog.reduce((n, s) => n + s.lessons.length, 0);
const deepLessons = catalog.reduce((n, s) => n + s.lessons.filter((l) => l.kind === 'deep').length, 0);

// 클라이언트 검색·진도 계산용 최소 데이터 (하드코딩 없이 콘텐츠에서 생성)
const index = catalog.map((s) => ({
  id: s.id, title: s.data.title, icon: s.data.icon, url: s.url, key: s.progressKey,
  orders: s.lessons.map((l) => l.order),
  lessons: s.lessons.map((l) => ({ o: l.order, t: l.title, u: l.url })),
}));
---
<Base title="CS Learning Lab">
  <div class="shell">
    <section class="hero">
      <div class="eyebrow">LEARN · EXPERIMENT · UNDERSTAND</div>
      <h1>보이지 않는 원리를<br />직접 조작하며 배우기</h1>
      <p>쉬운 비유로 들어가서, 내부에서 실제로 일어나는 일까지 내려갑니다. 값을 바꾸고, 한 단계씩 실행하고, 일부러 고장 내 보면서 이해하는 컴퓨터공학 학습 공간입니다.</p>
    </section>

    <section class="stats" aria-label="학습 현황">
      <div class="stat card"><strong>{catalog.length}</strong><span>과목</span></div>
      <div class="stat card"><strong>{totalLessons}</strong><span>강의</span></div>
      <div class="stat card"><strong id="stat-done">0</strong><span>완료한 강의</span></div>
    </section>

    <section aria-labelledby="continue-h">
      <div class="section-head"><h2 id="continue-h">이어서 학습하기</h2></div>
      <div class="card continue">
        <div>
          <div class="muted small" id="continue-tag">{catalog[0]?.data.icon} {catalog[0]?.data.area}</div>
          <h3 id="continue-title">{catalog[0]?.data.title} · 1강</h3>
          <div class="muted small" id="continue-caption">처음부터 시작해 보세요.</div>
          <div class="progress" style="margin-top:10px" role="progressbar" aria-label="이 과목의 학습 진도" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="continue-bar"><i id="continue-fill"></i></div>
          <div class="muted small" id="continue-progress" style="margin-top:4px"></div>
        </div>
        <a class="btn" id="continue-link" href={catalog[0]?.lessons[0]?.url ?? '/'}>학습 계속하기 →</a>
      </div>
    </section>

    <section id="subjects" aria-labelledby="subjects-h">
      <div class="section-head"><h2 id="subjects-h">모든 과목</h2><span class="muted small" id="count">{catalog.length}개 과목</span></div>
      <label class="search-box">
        <span aria-hidden="true">⌕</span>
        <span class="sr-only">과목·강의 검색</span>
        <input id="search" type="search" placeholder="과목이나 강의 검색 (예: useState, FlatList)" autocomplete="off" enterkeyhint="search" />
      </label>
      <div class="chips" role="group" aria-label="분야">
        {fields.map((f, i) => <button class="chip" type="button" data-field={f} aria-pressed={i === 0 ? 'true' : 'false'}>{f}</button>)}
      </div>
      <div class="grid" id="grid">
        {catalog.map((s) => (
          <article class="card course" data-field={s.data.field} data-text={`${s.data.title} ${s.data.area} ${s.data.field} ${s.data.description}`.toLowerCase()} data-id={s.id}>
            <div class="course-icon" aria-hidden="true">{s.data.icon}</div>
            <div class="muted small">{s.data.field} · {s.data.area}</div>
            <h3>{s.data.title}</h3>
            <p>{s.data.description}</p>
            <div class="progress" style="margin-top:6px" aria-hidden="true"><i data-fill={s.id}></i></div>
            <div class="meta"><span data-meta={s.id}>{s.lessons.length}개 강의</span><a class="stretched" href={s.url} aria-label={`${s.data.title} 학습하기`}>학습하기 →</a></div>
          </article>
        ))}
      </div>
      <div id="lesson-results" hidden>
        <div class="section-head" style="margin-top:22px"><h2 style="font-size:18px">강의 검색 결과</h2></div>
        <div class="lesson-hits" id="lesson-hits"></div>
      </div>
      <div class="empty" id="empty" hidden>검색 결과가 없습니다. 다른 검색어나 분야를 선택해 보세요.</div>
    </section>
    <p class="muted small" style="margin-top:24px">새 기준 강의 {deepLessons}개 · 각 강의에는 직접 조작하는 실습이 있으며, <span class="badge sim">시뮬레이션</span>과 <span class="badge real">실제 실행</span>을 구분해 표시합니다.</p>
  </div>

  <script type="application/json" id="catalog-data" set:html={JSON.stringify(index)} />
  <script>
    import { countDone, getLast } from '../scripts/progress';
    type Item = { id: string; title: string; icon: string; url: string; key: string; orders: number[]; lessons: { o: number; t: string; u: string }[] };
    const data: Item[] = JSON.parse(document.getElementById('catalog-data')!.textContent || '[]');
    const $ = (id: string) => document.getElementById(id)!;

    // 진도
    let doneTotal = 0;
    for (const s of data) {
      const done = countDone(s.key, s.orders);
      doneTotal += done;
      const pct = s.orders.length ? Math.round((done / s.orders.length) * 100) : 0;
      const fill = document.querySelector<HTMLElement>(`[data-fill="${s.id}"]`);
      if (fill) fill.style.width = pct + '%';
      const meta = document.querySelector(`[data-meta="${s.id}"]`);
      if (meta) meta.textContent = `${s.orders.length}개 강의 · ${done}개 완료`;
    }
    $('stat-done').textContent = String(doneTotal);

    // 이어서 학습하기
    const last = getLast();
    const cur = data.find((s) => s.id === last.subject) ?? data[0];
    if (cur) {
      const lesson = cur.lessons.find((l) => l.o === last.order) ?? cur.lessons[0];
      const done = countDone(cur.key, cur.orders);
      const pct = cur.orders.length ? Math.round((done / cur.orders.length) * 100) : 0;
      $('continue-tag').textContent = cur.icon + ' ' + cur.title;
      $('continue-title').textContent = `${lesson.o}강 · ${lesson.t}`;
      $('continue-caption').textContent = last.subject ? '마지막으로 보던 강의입니다.' : '처음부터 시작해 보세요.';
      ($('continue-link') as HTMLAnchorElement).href = lesson.u;
      ($('continue-fill') as HTMLElement).style.width = pct + '%';
      $('continue-bar').setAttribute('aria-valuenow', String(pct));
      $('continue-progress').textContent = `${done} / ${cur.orders.length}강 완료 (${pct}%)`;
    }

    // 검색 + 분야 필터
    let field = '전체';
    let query = '';
    const cards = [...document.querySelectorAll<HTMLElement>('#grid .course')];
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
    function render() {
      let shown = 0;
      for (const c of cards) {
        const ok = (field === '전체' || c.dataset.field === field) && (!query || (c.dataset.text || '').includes(query));
        c.hidden = !ok;
        if (ok) shown++;
      }
      $('count').textContent = shown + '개 과목';
      const hits = $('lesson-hits');
      hits.replaceChildren();
      let lessonCount = 0;
      if (query) {
        for (const s of data) {
          for (const l of s.lessons) {
            if (!(`${l.o}강 ${l.t}`).toLowerCase().includes(query)) continue;
            const a = document.createElement('a');
            a.className = 'card lesson-hit';
            a.href = l.u;
            const ico = document.createElement('span'); ico.textContent = s.icon; ico.setAttribute('aria-hidden', 'true');
            const t = document.createElement('span'); t.textContent = `${s.title} ${l.o}강 · ${l.t}`;
            a.append(ico, t);
            hits.append(a);
            lessonCount++;
          }
        }
      }
      $('lesson-results').hidden = lessonCount === 0;
      $('empty').hidden = shown + lessonCount !== 0;
    }
    for (const chip of chips) chip.addEventListener('click', () => {
      field = chip.dataset.field || '전체';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      render();
    });
    ($('search') as HTMLInputElement).addEventListener('input', (e) => {
      query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      render();
    });
  </script>
</Base>
