---
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/catalog';

const catalog = await getCatalog();
const fields = ['전체', ...new Set(catalog.map((s) => s.data.field))];
const totalLessons = catalog.reduce((n, s) => n + s.lessons.length, 0);

const updated = catalog.flatMap((s) => s.lessons.map((l) => l.mdx.data.updated)).sort((a, b) => +b - +a)[0];
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// 클라이언트 검색·진도 계산용 최소 데이터 (하드코딩 없이 콘텐츠에서 생성)
const index = catalog.map((s) => ({
  id: s.id, title: s.data.title, icon: s.data.icon, url: s.url, key: s.progressKey,
  orders: s.lessons.map((l) => l.order),
  lessons: s.lessons.map((l) => ({ o: l.order, t: l.title, u: l.url })),
}));
---
<Base title="CS Learning Lab">
  <div class="shell">
    <section class="sheet" aria-labelledby="hero-h">
      <div class="sheet-body grid-paper">
        <h1 id="hero-h">보이지 않는 원리를 손으로 움직여 보는 곳</h1>
        <p class="sheet-lead">비유로 들어가 내부 동작까지 내려갑니다. 값을 바꾸고, 한 단계씩 실행하고, 일부러 고장 내 보면서 컴퓨터가 실제로 하는 일을 확인합니다.</p>
      </div>
      <dl class="titleblock" aria-label="학습 현황">
        <div><dt>과목</dt><dd>{catalog.length}</dd></div>
        <div><dt>강의</dt><dd>{totalLessons}</dd></div>
        <div><dt>완료한 강의</dt><dd id="stat-done">0</dd></div>
        {updated && <div class="tb-wide"><span>마지막 갱신</span><span class="num">{fmt(updated)}</span></div>}
      </dl>
    </section>

    {totalLessons > 0 && (
      <section aria-labelledby="continue-h">
        <div class="section-head"><h2 id="continue-h">이어서 학습하기</h2></div>
        <div class="continue">
          <div>
            <div class="where" id="continue-tag">{catalog[0]?.data.title}</div>
            <h3 id="continue-title">1강</h3>
            <div class="progress" style="max-width:360px;margin-top:10px" role="progressbar" aria-label="이 과목의 학습 진도" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="continue-bar"><i id="continue-fill"></i></div>
            <div class="where num" id="continue-progress" style="margin-top:6px"></div>
          </div>
          <a class="btn" id="continue-link" href={catalog[0]?.lessons[0]?.url ?? '/'}>이 강의 열기</a>
        </div>
      </section>
    )}

    <section id="subjects" aria-labelledby="subjects-h">
      <div class="section-head"><h2 id="subjects-h">과목 목록</h2><span class="count" id="count">{catalog.length}개</span></div>
      {catalog.length > 0 ? (
        <>
          <div class="finder">
            <label class="search-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <span class="sr-only">과목과 강의 검색</span>
              <input id="search" type="search" placeholder="과목이나 강의 이름으로 찾기" autocomplete="off" enterkeyhint="search" />
            </label>
            {fields.length > 2 && (
              <div class="chips" role="group" aria-label="분야로 거르기">
                {fields.map((f, i) => <button class="chip" type="button" data-field={f} aria-pressed={i === 0 ? 'true' : 'false'}>{f}</button>)}
              </div>
            )}
          </div>
          <ol class="index" id="grid">
            {catalog.map((s, i) => (
              <li class="index-row course" data-field={s.data.field} data-text={`${s.data.title} ${s.data.area} ${s.data.field} ${s.data.description}`.toLowerCase()} data-id={s.id}>
                <span class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3><a href={s.url}>{s.data.title}</a></h3>
                  <div class="field">{s.data.field}, {s.data.area}</div>
                  <p>{s.data.description}</p>
                </div>
                <div class="meta">
                  <span data-meta={s.id}>강의 {s.lessons.length}개</span>
                  <div class="progress" aria-hidden="true"><i data-fill={s.id}></i></div>
                </div>
              </li>
            ))}
          </ol>
          <div id="lesson-results" hidden>
            <div class="section-head" style="margin-top:28px"><h2 style="font-size:17px">일치하는 강의</h2></div>
            <div class="lesson-hits" id="lesson-hits"></div>
          </div>
          <div class="empty" id="empty" hidden><strong>찾는 과목이나 강의가 없습니다.</strong>검색어를 줄이거나 분야를 전체로 바꿔 보세요.</div>
        </>
      ) : (
        <div class="empty" id="no-subjects">
          <strong>아직 과목이 없습니다.</strong>
          배우고 싶은 주제를 요청하면 강의와 실습이 이 목록에 추가됩니다.
        </div>
      )}
    </section>
  </div>

  <script type="application/json" id="catalog-data" set:html={JSON.stringify(index)} />
  <script>
    import { countDone, getLast } from '../scripts/progress';
    type Item = { id: string; title: string; icon: string; url: string; key: string; orders: number[]; lessons: { o: number; t: string; u: string }[] };
    const data: Item[] = JSON.parse(document.getElementById('catalog-data')!.textContent || '[]');
    const $ = (id: string) => document.getElementById(id)!;

    // 진도
    let doneTotal = 0;
    for (const s of data) {
      const done = countDone(s.key, s.orders);
      doneTotal += done;
      const pct = s.orders.length ? Math.round((done / s.orders.length) * 100) : 0;
      const fill = document.querySelector<HTMLElement>(`[data-fill="${s.id}"]`);
      if (fill) fill.style.width = pct + '%';
      const meta = document.querySelector(`[data-meta="${s.id}"]`);
      if (meta) meta.textContent = `강의 ${s.orders.length}개 중 ${done}개 완료`;
    }
    $('stat-done').textContent = String(doneTotal);

    // 이어서 학습하기
    const last = getLast();
    const cur = data.find((s) => s.id === last.subject) ?? data[0];
    if (cur && cur.lessons.length && document.getElementById('continue-title')) {
      const lesson = cur.lessons.find((l) => l.o === last.order) ?? cur.lessons[0];
      const done = countDone(cur.key, cur.orders);
      const pct = cur.orders.length ? Math.round((done / cur.orders.length) * 100) : 0;
      $('continue-tag').textContent = cur.title + (last.subject ? ', 마지막으로 보던 강의' : ', 처음부터');
      $('continue-title').textContent = `${lesson.o}강. ${lesson.t}`;
      ($('continue-link') as HTMLAnchorElement).href = lesson.u;
      ($('continue-fill') as HTMLElement).style.width = pct + '%';
      $('continue-bar').setAttribute('aria-valuenow', String(pct));
      $('continue-progress').textContent = `${done} / ${cur.orders.length}강 완료 (${pct}%)`;
    }

    // 검색 + 분야 필터
    let field = '전체';
    let query = '';
    const cards = [...document.querySelectorAll<HTMLElement>('#grid .course')];
    const search = document.getElementById('search') as HTMLInputElement | null;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
    function render() {
      let shown = 0;
      for (const c of cards) {
        const ok = (field === '전체' || c.dataset.field === field) && (!query || (c.dataset.text || '').includes(query));
        c.hidden = !ok;
        if (ok) shown++;
      }
      $('count').textContent = shown + '개';
      const hits = $('lesson-hits');
      hits.replaceChildren();
      let lessonCount = 0;
      if (query) {
        for (const s of data) {
          for (const l of s.lessons) {
            if (!(`${l.o}강 ${l.t}`).toLowerCase().includes(query)) continue;
            const a = document.createElement('a');
            a.className = 'lesson-hit';
            a.href = l.u;
            const no = document.createElement('span'); no.className = 'no'; no.textContent = `${s.title} ${l.o}강`;
            const t = document.createElement('span'); t.textContent = l.t;
            a.append(no, t);
            hits.append(a);
            lessonCount++;
          }
        }
      }
      $('lesson-results').hidden = lessonCount === 0;
      $('empty').hidden = shown + lessonCount !== 0;
    }
    for (const chip of chips) chip.addEventListener('click', () => {
      field = chip.dataset.field || '전체';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      render();
    });
    search?.addEventListener('input', () => {
      query = search.value.trim().toLowerCase();
      render();
    });
  </script>
</Base>
