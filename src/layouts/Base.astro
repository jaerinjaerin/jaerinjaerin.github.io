---
import '@fontsource/ibm-plex-sans-kr/400.css';
import '@fontsource/ibm-plex-sans-kr/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/base.css';
interface Props { title: string; description?: string; }
const { title, description = '원리를 직접 조작하며 깊게 배우는 컴퓨터공학 학습 노트' } = Astro.props;
const fullTitle = title === 'CS Learning Lab' ? title : `${title} | CS Learning Lab`;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1b2a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='1.5' y='1.5' width='29' height='29' fill='%23f2f4f1' stroke='%23172235' stroke-width='3'/><text x='16' y='21.5' font-family='sans-serif' font-weight='700' font-size='13' text-anchor='middle' fill='%23172235'>CS</text></svg>" />
    <title>{fullTitle}</title>
    <script is:inline>
      // 깜빡임 방지: 그리기 전에 테마 적용 (키 cs-theme)
      (function () {
        var t = '';
        try { t = localStorage.getItem('cs-theme') || ''; } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">본문으로 건너뛰기</a>
    <header class="topbar">
      <div class="shell topbar-in">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">CS</span><span>Learning Lab</span></a>
        <div class="top-actions">
          <slot name="actions" />
          <button class="icon-btn" type="button" id="theme-toggle">어둡게</button>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell">
        <span>CS Learning Lab. 쉽게 들어가 깊게 나오는 컴퓨터공학 노트</span>
        <span>진도는 이 브라우저에만 저장됩니다.</span>
      </div>
    </footer>
    <script>
      const btn = document.getElementById('theme-toggle')!;
      const paint = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        btn.textContent = dark ? '밝게' : '어둡게';
        btn.setAttribute('aria-label', dark ? '밝은 화면으로 바꾸기' : '어두운 화면으로 바꾸기');
      };
      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('cs-theme', next); } catch {}
        paint();
      });
      paint();
    </script>
  </body>
</html>
