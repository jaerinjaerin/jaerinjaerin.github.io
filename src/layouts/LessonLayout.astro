---
import Base from './Base.astro';
import type { SubjectItem, LessonItem } from '../lib/catalog';
interface Props {
  subject: SubjectItem;
  lesson: LessonItem;
}
const { subject, lesson } = Astro.props;
const idx = subject.lessons.findIndex((l) => l.order === lesson.order);
const prev = subject.lessons[idx - 1];
const next = subject.lessons[idx + 1];
const unit = subject.data.units.find((u) => u.id === lesson.unit);
const title = lesson.title;
const total = subject.lessons.length;
const minutes = lesson.mdx.data.minutes;
---
<Base title={`${lesson.order}강 ${title}, ${subject.data.title}`} description={lesson.summary}>
  <div class="shell lesson-wrap">
    <nav class="toc" aria-label="강의 목차">
      <details id="toc" open>
        <summary><span>{subject.data.title} 강의 목록</span><span class="muted small num" style="margin-left:auto">{total}강</span></summary>
        <div class="toc-body">
          {subject.data.units.map((u) => {
            const ls = subject.lessons.filter((l) => l.unit === u.id);
            if (!ls.length) return null;
            return (
              <>
                <div class="toc-unit">{u.title}</div>
                {ls.map((l) => (
                  <a href={l.url} data-order={l.order} aria-current={l.order === lesson.order ? 'page' : undefined}>
                    <span class="n">{String(l.order).padStart(2, '0')}</span>
                    <span>{l.title}</span>
                  </a>
                ))}
              </>
            );
          })}
        </div>
      </details>
    </nav>

    <article class="lesson">
      <header class="lesson-head">
        <div class="head-main grid-paper">
          <nav class="crumbs" aria-label="위치"><a href={subject.url}>{subject.data.title}</a><span class="sep">/</span><span>{unit?.title}</span></nav>
          <h1 class="lesson-title">{title}</h1>
        </div>
        <dl class="titleblock">
          <div><dt>강의 번호</dt><dd class="num">{String(lesson.order).padStart(2, '0')}</dd></div>
          <div><dt>단원</dt><dd>{unit?.title}</dd></div>
          <div><dt>예상 시간</dt><dd class="num">{minutes ? `${minutes}분` : '-'}</dd></div>
        </dl>
      </header>

      <slot />

      <div class="lesson-foot">
        <button class="btn complete-btn" type="button" id="complete" aria-pressed="false">이 강의를 완료로 표시</button>
        <div class="pager">
          {prev ? <a href={prev.url} rel="prev"><span>이전 강의</span>{prev.order}강. {prev.title}</a> : <span />}
          {next ? <a class="next" href={next.url} rel="next"><span>다음 강의</span>{next.order}강. {next.title}</a> : <span />}
        </div>
      </div>
    </article>
  </div>
  <script type="application/json" id="lesson-data" set:html={JSON.stringify({ subject: subject.id, key: subject.progressKey, order: lesson.order })} />
  <script>
    import { getDone, setDone, setLast } from '../scripts/progress';
    const d = JSON.parse(document.getElementById('lesson-data')!.textContent || '{}');
    setLast(d.subject, d.order);
    const btn = document.getElementById('complete') as HTMLButtonElement;
    function paint() {
      const done = getDone(d.key);
      document.querySelectorAll<HTMLElement>('.toc a[data-order]').forEach((a) => {
        a.dataset.done = String(Boolean(done[String(Number(a.dataset.order) - 1)]));
      });
      const me = Boolean(done[String(d.order - 1)]);
      btn.setAttribute('aria-pressed', String(me));
      btn.textContent = me ? '완료함 (누르면 취소)' : '이 강의를 완료로 표시';
    }
    btn.addEventListener('click', () => {
      setDone(d.key, d.order, btn.getAttribute('aria-pressed') !== 'true');
      paint();
    });
    paint();
    // 표: 각 칸에 열 제목을 붙여, 휴대폰에서 "행 = 카드"로 보여 준다 (CSS: table.rtable)
    document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
      const labels = [...table.querySelectorAll('thead th')].map((th) => th.textContent?.trim() ?? '');
      if (!labels.length) return;
      table.querySelectorAll('tbody tr').forEach((tr) => {
        [...tr.children].forEach((td, i) => { if (labels[i]) td.setAttribute('data-label', labels[i]); });
      });
      table.classList.add('rtable');
    });
    // 휴대폰에서는 목차를 접은 상태로 시작
    const toc = document.getElementById('toc') as HTMLDetailsElement;
    if (matchMedia('(max-width: 1023px)').matches) toc.open = false;
    else toc.addEventListener('toggle', () => { if (!toc.open) toc.open = true; }); // PC에서는 늘 펼친 상태
    const cur = toc.querySelector<HTMLElement>('[aria-current="page"]');
    const body = toc.querySelector<HTMLElement>('.toc-body');
    if (cur && body) body.scrollTop = Math.max(0, cur.offsetTop - body.offsetTop - 80);
  </script>
</Base>
