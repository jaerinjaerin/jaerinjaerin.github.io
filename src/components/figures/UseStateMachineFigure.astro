---
/**
 * Anatomy 그림 (Fig 4-1): useState 업데이트 큐를 티켓 레일 계수기로 보여준다.
 * SVG는 빌드할 때 kit로 만들고(런타임 JS 없음), 움직임만 클라이언트에서 붙인다.
 */
import { ISO_CSS } from '../../figures/kit/iso-kit.mjs';
import { buildFigure, LIVE, P } from '../../figures/use-state-machine/geometry.mjs';
const svg = buildFigure();
const data = JSON.stringify({ live: LIVE, P });
---
<Fragment set:html={`<style>${ISO_CSS}</style>`} />
<div class="iso usm" data-theme="light" data-figure="use-state-machine" data-config={data}>
  <figure class="iso-figure">
    <div class="iso-plate">
      <div class="iso-plate-corners" aria-hidden="true">
        <span class="iso-plate-corner" data-corner="fig">Fig 4-1</span>
        <span class="iso-plate-corner" data-corner="title">티켓 레일 계수기</span>
        <span class="iso-plate-corner" data-corner="hint">← → 한 단계 · Space 재생</span>
        <span class="iso-plate-corner" data-corner="readout" data-readout>1/9 · 이벤트 처리</span>
      </div>
      <div class="iso-stage" tabindex="0" role="group" aria-label="티켓 레일 계수기: 왼쪽·오른쪽 화살표로 한 단계씩 진행" set:html={svg} />
    </div>
    <div class="usm-controls">
      <div class="usm-scenes" role="group" aria-label="장면 선택">
        <button type="button" data-scene="value3">🐞 count + 1 × 3</button>
        <button type="button" data-scene="fn3">c => c + 1 × 3</button>
        <button type="button" data-scene="mixed">+5 → c+1 → 42</button>
      </div>
      <div class="usm-transport">
        <button type="button" data-prev aria-label="이전 단계">◀</button>
        <button type="button" data-play aria-pressed="true">⏸ 일시정지</button>
        <button type="button" data-next aria-label="다음 단계">▶</button>
      </div>
      <p class="usm-narration" data-narration aria-live="polite"></p>
    </div>
    <figcaption class="iso-legend">
      <span class="iso-caption">
        <strong>읽는 법</strong> — 왼쪽 <b>발행기</b>는 이벤트 핸들러입니다. setCount를 부를 때마다 <b>티켓</b>(업데이트)을 찍어 <b>레일</b>(업데이트 큐)에 세웁니다. 평평한 티켓은 "그 값으로 교체", 핀이 솟은 티켓은 "직전 결과로 계산"입니다.
        다시 렌더할 때 티켓이 하나씩 <b>프레스</b>로 들어가 오른쪽 <b>계수기</b>(React가 보관한 값)를 바꿉니다. 뒤쪽 왼쪽 패널은 핸들러가 보는 <b>스냅샷</b>, 오른쪽 패널은 사용자가 보는 <b>화면</b>입니다. 화면은 맨 마지막 커밋에서만 바뀝니다.
        숫자는 아래 실습 1과 같은 모델에서 계산됩니다. <span class="badge sim">시뮬레이션</span>
      </span>
    </figcaption>
  </figure>
</div>
<style is:global>
  .usm { margin: 22px 0; font-size: 15px; }
  .usm .iso-figure { margin: 0; }
  .usm .iso-plate { border-radius: var(--radius); overflow: hidden; padding: 44px 6px 46px; box-shadow: 0 0 0 1px var(--border); }
  .usm .iso-stage { outline-offset: -3px; }
  .usm .iso-stage { overflow: hidden; margin: 0 -6px; }
  .usm .iso-stage svg { width: 124%; margin: -4% 0 -3% -12%; }
  .usm .usm-well { fill: var(--anatomy-shade-0); stroke: none; }
  .usm .usm-digits { font-weight: 700; letter-spacing: .02em; }
  .usm-controls { display: grid; gap: 8px; margin-top: 10px; }
  .usm-scenes, .usm-transport { display: flex; gap: 6px; flex-wrap: wrap; }
  .usm-controls button { min-height: 44px; padding: 6px 12px; border-radius: 12px; border: 1px solid var(--border); background: var(--surface); color: var(--text); font: 600 14px/1.2 var(--mono); }
  .usm-controls button[aria-pressed="true"] { background: var(--text); color: var(--bg); border-color: var(--text); }
  .usm-controls button:disabled { opacity: .4; }
  .usm-transport button[data-play] { flex: 1; font-family: var(--font); }
  .usm-transport button[data-prev], .usm-transport button[data-next] { width: 52px; }
  .usm-narration { margin: 0; padding: 10px 12px; border-radius: 12px; background: var(--surface-2); font-size: 15px; line-height: 1.6; min-height: 76px; color: var(--text-2); }
  .usm-narration strong { color: var(--text); }
  .usm .iso-legend { color: var(--text-2); font-size: 14.5px; }
  @media (max-width: 767px) {
    .usm-narration { font-size: 14px; min-height: 0; }
    .usm .iso-legend { font-size: 14px; }
    .usm-controls button { font-size: 13px; }
  }
  @media (min-width: 768px) {
    .usm .iso-plate { padding: 52px 24px 56px; }
    .usm .iso-stage { margin: 0; }
    .usm .iso-stage svg { width: 100%; margin: 0; }
  }
</style>
<script>
  import { mountUseStateFigure } from '../../figures/use-state-machine/live';
  document.querySelectorAll<HTMLElement>('[data-figure="use-state-machine"]').forEach((el) => {
    const { live, P } = JSON.parse(el.dataset.config || '{}');
    mountUseStateFigure(el, live, P);
  });
</script>
