---
import '../../labs/engine/step-lab.css';
---
<div class="us-lab" data-lab="use-state-queue"><noscript>이 실습은 JavaScript가 필요합니다.</noscript></div>
<style is:global>
  .us-builder { display: grid; gap: 6px; width: 100%; padding: 10px 12px; border-radius: 12px; background: var(--surface-2); }
  .us-builder[hidden] { display: none; }
  .us-line { min-height: 40px; cursor: pointer; }
  .us-add { min-height: 40px; font-family: var(--mono); font-size: 13px; font-weight: 600; padding: 4px 10px; }
  .us-missions { display: grid; gap: 6px; }
  .us-mission { padding: 8px 12px; border-radius: 10px; background: var(--surface-2); font-size: 14.5px; }
  .us-mission[data-ok="true"] { background: var(--ok-bg); }
  .us-missions-intro { padding: 8px 12px; border-radius: 10px; background: var(--surface-2); }
</style>
<script>
  import { mountUseStateLab } from '../../labs/react/use-state-queue';
  document.querySelectorAll<HTMLElement>('[data-lab="use-state-queue"]').forEach((el) => mountUseStateLab(el));
</script>
